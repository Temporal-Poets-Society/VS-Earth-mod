      {"name": "shelf", "surface": ["sea"], "units": {"default": "marine"}},
      {"name": "peatland-glaciated", "note": "Histosols are peat whatever the sediment map says under them (West Siberia read half loess, 7 November); on formerly glaciated ground over till.", "surface": ["land", "beach", "riverbed"], "field": "glaciation", "values": ["older", "lgm"], "fields": [{"field": "soil_group", "values": ["Histosols"]}], "units": {"*": "peat-on-till"}},
