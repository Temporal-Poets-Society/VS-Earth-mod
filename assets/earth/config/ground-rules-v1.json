    "thicknessNote": "Corrections where a thickness data set is known to run thick or thin (GroundColumns.ThicknessRule): first match wins, only for values read from a tile whose source contains one of sources, only for the listed recipes when given; the value is multiplied by scale and held within minMetres..maxMetres. /earth geology names the rule after the source.",
    "thickness": [
      {"name": "shield-cover", "note": "Shangguan runs about 1.5x thick on the glaciated Precambrian shields: the Finnish lakes box read a mean of 12.6 m where GTK gives 8.6 m for Finland (world QC, 7 November).", "sources": ["shangguan"], "field": "glaciation", "values": ["older", "lgm"], "fields": [{"field": "bedrock_era", "values": ["Archean", "Eoarchean", "Archean-Paleoproterozoic", "Paleoproterozoic", "Paleoproterozoic-Mesoproterozoic", "Mesoproterozoic", "Mesoproterozoic-Neoproterozoic", "Neoproterozoic", "Proterozoic", "Precambrian"]}], "scale": 0.68},
      {"name": "sand-sea", "note": "A dune field stands on at least the sand of its dunes; Shangguan reads 4 m in the Kalahari, whose sands are tens of metres thick.", "sources": ["shangguan"], "recipes": ["dune"], "minMetres": 15}
    ],
    "regions": [
      {"name": "lake-glaciated", "note": "Lake floors on formerly glaciated ground: varved lake clay over till.", "surface": ["lake"], "field": "glaciation", "values": ["older", "lgm"], "units": {"*": "lakeclay"}},
      {"name": "lake", "note": "Lake floors (Earth's lakes): lake silt and clay over the unit.", "surface": ["lake"], "units": {"*": "lake"}},
      {"name": "deep-sea-siliceous", "note": "Open sea beyond the coastal fill (no unit mapped). High latitudes below 1000 m: diatom ooze.", "surface": ["sea"], "elevation": [-12000, -1000], "absLat": [50, 90], "units": {"default": "ooze-siliceous"}},
      {"name": "abyssal", "note": "Below the carbonate compensation depth (about 4500 m): red clay.", "surface": ["sea"], "elevation": [-12000, -4500], "units": {"default": "pelagic-clay"}},
