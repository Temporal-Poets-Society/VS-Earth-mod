  "tiles": [
    {"file": "ground/global-soilgroup-30s.egts",  "optional": true, "priority": 60, "note": "SoilGrids 2.0 WRB group at 30\" (the most common full-resolution class); VintagestoryData/ModData/earth, from tools/ground/bake_30s.py, not in Earth's archives"},
