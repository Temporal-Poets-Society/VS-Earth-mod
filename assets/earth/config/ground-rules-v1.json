  "cover": {
    "note": "Surface sediment unit (GUM code, Boerker et al. 2018; R* = no loose sediment mapped, rock class from GLiM, see tools/ground/bake_baltic.py) -> recipe. Codes not listed use 'default' and are logged once. 'regions' replace the unit map where their condition holds, first match first (the place from the game: lake and sea floors by depth and latitude, formerly glaciated ground where everything sits on till, Earth's river valleys, then soil groups standing in for climate). A region's keys are unit codes, 'default' (no unit mapped) or '*' (any unit). Condition keys: areas, field + values or min/max, fields, elevation [from, to) in real metres, absLat, surface (land, beach, sea, lake, riverbed), nearRiver. Recipes list layers top to bottom as shares of the column's Quaternary thickness; 'max' caps a layer in metres (the excess goes to the last layer), 'vary' changes a share by up to that fraction with position, and the last layer takes the rest. typicalMetres is the thickness used where no thickness tile has data; maxMetres caps the tile's thickness for a recipe (Shangguan's depth to bedrock runs to 100 m and more on bare rock in deserts and shields, 7 November). Glacial recipes are cycles (the author's shaft review): upper till, sand and gravel between tills, lower till. Materials named earth:* that do not exist yet fall back to vanilla blocks (placeholders; the author, 7 November: placement first, textures later).",
    "default": "residual",
    "units": {
      "Gt": "till", "Gu": "till", "Gm": "till", "Gp": "till", "Gl": "lakeclay", "Gf": "outwash",
      "Au": "alluvium", "Al": "alluvium", "Ap": "alluvium", "Ae": "alluvium", "At": "alluvium", "Af": "fan",
      "Op": "peat", "Ou": "peat",
      "Ed": "dune", "Eu": "dune", "Er": "dune", "Ea": "dune", "El": "loess",
      "Lu": "lake", "Wu": "lake", "Wl": "lake",
      "Mu": "marine", "Yb": "coastal", "Ys": "coastal", "Ym": "coastal", "Yu": "coastal", "Yd": "delta", "Yl": "delta",
      "Ca": "colluvium", "Cu": "colluvium", "Us": "sediment",
      "Pg": "playa", "Pp": "playa", "Ps": "playa", "Pu": "playa",
      "Iy": "tephra", "Du": "ice",
      "Rx": "residual", "Rm": "residual-mafic", "Rk": "residual-karst", "Zu": "residual"
