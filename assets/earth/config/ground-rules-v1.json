      "Cambrian": "cambrian", "Early Cambrian": "cambrian", "Proterozoic III - Cambrian": "cambrian", "Proterozoic III - Middle Cambrian": "cambrian",
      "Precambrian": "basement", "Proterozoic": "basement", "Proterozoic I": "basement", "Proterozoic II": "basement", "Proterozoic III": "basement",
