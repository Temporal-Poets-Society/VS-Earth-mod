        {"name": "triassic",        "layers": [{"m": "claystone", "metres": 40, "lith": "clay"}]},
        {"name": "permian",         "layers": [{"m": "limestone", "metres": 15, "lith": "limestone"}, {"m": "dolostone", "metres": 20, "lith": "dolomite"}]},
        {"name": "carboniferous",   "layers": [{"m": "sandstone", "metres": 30, "lith": "sandstone"}, {"m": "marl-devonian", "metres": 15, "lith": "marl"}, {"m": "dolostone", "metres": 10, "lith": "dolomite"}]},
        {"name": "devonian-upper",  "layers": [
          {"m": "dolostone",     "metres": 15, "lith": "dolomite", "name": "Daugava"},
          {"m": "marl-devonian", "metres": 8,  "lith": "marl",     "name": "Salaspils"},
          {"m": "dolostone",     "metres": 15, "name": "Plavinas"},
          {"m": "sandstone",     "metres": 25, "lith": "sandstone", "name": "Amata"},
          {"m": "clay-red",      "metres": 5,  "lith": "clay",     "name": "Amata clay"},
