        {"name": "cenozoic", "layers": [{"m": "sandstone", "metres": 300}, {"m": "claystone", "metres": 300}, {"m": "conglomerate", "metres": 100}]},
        {"name": "mesozoic", "layers": [{"m": "sandstone", "metres": 300}, {"m": "shale", "metres": 400}, {"m": "limestone", "metres": 300}]},
        {"name": "paleozoic", "layers": [{"m": "limestone", "metres": 400}, {"m": "shale", "metres": 400}, {"m": "dolostone", "metres": 200}, {"m": "sandstone", "metres": 300}]},
        {"name": "proterozoic", "layers": [{"m": "sandstone", "metres": 300}, {"m": "quartzite", "metres": 300}, {"m": "slate", "metres": 300}]}
      ]},
      "foldbelt": {"note": "Generic: thinner beds, metamorphosed with age (orogenic belts, accretionary complexes).", "eras": {"*": "cenozoic", "Cenozoic": "cenozoic", "Mesozoic-Cenozoic": "cenozoic", "Phanerozoic": "cenozoic", "Mesozoic": "mesozoic", "Paleozoic-Mesozoic": "mesozoic", "Paleozoic": "paleozoic", "Precambrian-Phanerozoic": "paleozoic", "Neoproterozoic": "proterozoic", "Mesoproterozoic-Neoproterozoic": "proterozoic", "Mesoproterozoic": "proterozoic", "Proterozoic": "proterozoic", "Paleoproterozoic-Mesoproterozoic": "proterozoic", "Paleoproterozoic": "proterozoic", "Archean-Paleoproterozoic": "basement", "Archean": "basement", "Eoarchean": "basement", "Precambrian": "basement"}, "basement": [{"m": "schist", "share": 0.4}, {"m": "gneiss", "share": 0.3}, {"m": "granite", "share": 0.3}], "units": [
