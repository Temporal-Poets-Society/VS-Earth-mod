  "compaction": {
    "note": "Loose sediment becomes rock below this depth (metres from the column's top). Shallow Devonian clay stays raw clay (quarried at the surface); the Cambrian blue clay at 700-900 m under Latvia is claystone, under Tallinn at about 100 m it stays clay. Proposal: 150-200 m.",
    "clay-red":  {"belowMetres": 200, "m": "claystone"},
    "clay-blue": {"belowMetres": 200, "m": "claystone"},
    "silt":      {"belowMetres": 200, "m": "claystone"},
    "mud":       {"belowMetres": 200, "m": "claystone"},
    "sand":      {"belowMetres": 150, "m": "sandstone"},
    "gravel":    {"belowMetres": 150, "m": "conglomerate"},
    "ooze-calcareous":  {"belowMetres": 200, "m": "chalk"},
    "ooze-siliceous":   {"belowMetres": 200, "m": "chert"},
    "carbonate-sand":   {"belowMetres": 150, "m": "limestone"}
  },

  "relief": {
    "note": "Cover follows the land's shape: thickness from the data times exp(-relief/scaleMetres) / (1 + (slope/slopeHalf)^2), within min and max, where relief is the height above the mean ground within radiusMetres (negative in hollows and valleys) and slope is rise over run at about a third of that radius. A knoll 10 m above its surroundings keeps about 30 % of the cell's cover, one 25 m above about 4 %; a hollow 8 m down gets about 2.5 times. Dunes, loess and tephra are the relief themselves and keep theirs. With the crest regions above, a glaciated shield gets bare-rock knolls with a skin of till next to valleys full of sediment.",
    "radiusMetres": 1200, "scaleMetres": 8, "min": 0.03, "max": 2.5, "slopeHalf": 0.4,
    "when": {"surface": ["land", "beach", "riverbed"]},
    "skipRecipes": ["dune", "dune-on-till", "loess", "loess-on-till", "sand-sheet", "sand-on-saprolite", "tephra", "ice"]
  },

  "frozen": {
    "note": "Permafrost (Obu et al. 2019 probability, %): loose cover below the active layer is frozen. Lake and river floors stay thawed (taliks); peat keeps its block.",
    "field": "permafrost_pct",
    "min": 50,
    "surface": ["land", "beach"],
    "belowMetres": 1.0,
    "materials": {"silt": "permafrost-silt", "mud": "permafrost-silt", "loess": "permafrost-silt", "colluvium": "permafrost-till", "regolith": "permafrost-till", "till-grey": "permafrost-till", "till-reddish": "permafrost-till", "sand": "permafrost-sand", "gravel": "permafrost-gravel", "clay-blue": "permafrost-clay", "clay-red": "permafrost-clay"}
  },

  "basement": {
    "note": "Crystalline basement to the bottom of the world. 'rocks' maps names of a basement_rock tile (none yet); without one, a deterministic mix of large bodies about bodyKm across (Baltic: mostly gneiss with granite plutons, e.g. the Riga rapakivi pluton). Gneiss falls back to vanilla slate without Geology Additions.",
    "default": "granite",
    "rocks": {"granite": "granite", "rapakivi granite": "granite", "gneiss": "gneiss"},
    "mix": [{"m": "gneiss", "share": 0.65}, {"m": "granite", "share": 0.35}],
    "bodyKm": 40
