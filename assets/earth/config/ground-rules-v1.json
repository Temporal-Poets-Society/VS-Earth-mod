       "nearRiver": false, "field": "glaciation", "values": ["older", "lgm"], "fields": [{"field": "soil_group", "values": ["Chernozems", "Kastanozems", "Phaeozems", "Cryosols", "Luvisols", "Cambisols", "Albeluvisols", "Calcisols", "Solonetz", "Planosols", "Gleysols", "Vertisols", "Stagnosols", "Umbrisols"]}, {"field": "clay_pct", "min": 12}],
