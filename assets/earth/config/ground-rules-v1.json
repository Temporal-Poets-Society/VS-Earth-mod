    {"asset": "earth:config/ground/europe-igme5000.egt",       "priority": 100, "note": "IGME 5000 pre-Quaternary age and lithology words (terms to check: tests and prototype only)"},
    {"asset": "earth:config/ground/global-soilgrids.egts",     "priority": 50,  "note": "SoilGrids 2.0 WRB group, clay and pH at 2', world (10-degree tiles, unpacked on demand)"},
    {"asset": "earth:config/ground/global-shangguan.egts",     "priority": 50,  "note": "Shangguan et al. 2017 depth to bedrock at 2', world"},
    {"asset": "earth:config/ground/global-glaciation.egts",    "priority": 10,  "note": "Batchelor et al. 2019 ice-sheet extents at 2' (older, lgm), Northern Hemisphere"},
    {"asset": "earth:config/ground/global-permafrost.egts",    "priority": 10,  "note": "Obu et al. 2019 permafrost probability at 2', Northern Hemisphere"},
