        {"name": "mesozoic", "layers": [{"m": "shale", "metres": 300}, {"m": "limestone", "metres": 300}, {"m": "sandstone", "metres": 200}]},
        {"name": "paleozoic", "layers": [{"m": "slate", "metres": 400}, {"m": "phyllite", "metres": 300}, {"m": "quartzite", "metres": 200}]},
        {"name": "proterozoic", "layers": [{"m": "schist", "metres": 500}, {"m": "quartzite", "metres": 200}]}
      ]},
      "shield": {"note": "Generic: Precambrian shield or craton crust; CRUST1.0 gives little or no sediment, so the basement comes up under the cover.", "like": "platform", "basement": [{"m": "gneiss", "share": 0.55}, {"m": "granite", "share": 0.35}, {"m": "schist", "share": 0.1}]},
      "arc": {"note": "Generic: crust built as a volcanic arc (often an old, buried one, such as the Svecofennian or Yavapai arcs): platform beds over diorite, granite and andesite.", "like": "platform", "basement": [{"m": "diorite", "share": 0.4}, {"m": "granite", "share": 0.35}, {"m": "andesite", "share": 0.25}]},
      "magmatic": {"note": "Generic: large igneous province crust: platform beds over granite, gneiss and gabbro (exposed flood basalt is regional geology's).", "like": "platform", "basement": [{"m": "granite", "share": 0.4}, {"m": "gneiss", "share": 0.3}, {"m": "gabbro", "share": 0.3}]},
      "oceanic": {"note": "Generic oceanic crust under the sea-floor sediment (CRUST1.0's depth is that sediment): pillow basalt with gabbro bodies.", "eras": {"*": "basement"}, "basement": [{"m": "basalt", "share": 0.8}, {"m": "gabbro", "share": 0.2}]},
      "ophiolite": {"note": "Generic ophiolite: oceanic mantle and crust thrust onto land.", "eras": {"*": "basement"}, "basement": [{"m": "peridotite", "share": 0.5}, {"m": "gabbro", "share": 0.3}, {"m": "basalt", "share": 0.2}]},
      "baltic": {"area": [20.0, 53.5, 29.0, 60.0], "units": [
