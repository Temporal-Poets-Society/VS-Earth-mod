    {"asset": "earth:config/ground/baltic-soilgrids.egt",      "priority": 200, "note": "SoilGrids 2.0 WRB group, clay, pH"},
    {"asset": "earth:config/ground/baltic-emodnet-seabed.egt", "priority": 200, "note": "EMODnet seabed substrate, Folk 7"},
