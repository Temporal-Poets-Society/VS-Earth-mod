<Project Sdk="Microsoft.NET.Sdk">
  <!-- Decision 0051: converts published GLO-90 GeoTIFFs in a local folder into Earth's tile store, with the mod's own code. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><LangVersion>12</LangVersion><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable></PropertyGroup>
  <ItemGroup><Compile Include="../../src/Core/*.cs" Link="Core/%(Filename)%(Extension)" /></ItemGroup>
</Project>
