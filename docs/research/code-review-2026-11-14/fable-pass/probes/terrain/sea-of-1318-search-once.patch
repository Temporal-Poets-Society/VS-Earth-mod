+            double dist = found >= reach ? reach : Math.Max(near, found - 0.5 * step);
+            double result = -Math.Clamp(dist, 0.5, reach);
+            { int slot = coastMemoNext; coastMemoNext = (slot + 1) % CoastMemoSize; memo[3 * slot] = lat; memo[3 * slot + 1] = lon; memo[3 * slot + 2] = result; owners[slot] = CacheId; }
+            return result;
+        }
