+        /// <summary>Land of 1318 for <see cref="CoastDistanceAt"/>: a LAND area of 0064, or the outline's land outside its SEA areas.</summary>
+        bool Land1318(double lat, double lon)
+        {
+            // PROTOTYPE (review): the same answer as WorksAt + the outline, with the outline asked before the enclosure
+            // search: today's sea is no land of 1318 whether SEA areas enclose it or not
+            if (Works == null || Coasts == null)
+            {
+                double s0 = Coasts.SignedDistance(lat, lon);
+                return !double.IsNaN(s0) && s0 >= 0;
+            }
+            var h = Works.At(lat, lon);
+            if (h.Covered && h.Inside && (h.Flags & Works1318Data.Land) != 0) return true;
+            if (h.Covered && h.Inside && (h.Flags & Works1318Data.Sea) != 0) return false;
+            double s = Coasts.SignedDistance(lat, lon);
+            if (!(!double.IsNaN(s) && s >= 0)) return false;
+            if (WorksRules >= 3 && h.Covered && !h.Inside && !double.IsNaN(h.Level) && (h.Flags & Works1318Data.Sea) != 0)
+            {
+                var e = EnclosedBySea(lat, lon, h, false);
+                if (e.Covered && e.Inside && (e.Flags & Works1318Data.Land) != 0) return true;
+                if (e.Covered && e.Inside && (e.Flags & Works1318Data.Sea) != 0) return false;
+            }
+            return true;
+        }
