+            int top = (int)Math.Floor(Vertical.Y(h));
+            double o = s.Ocean;
+            double l = double.IsNaN(s.LakeLevel) ? 0 : s.Lake;
+            int lakeTop = l > 0 ? WaterTopY(s.LakeLevel) : int.MinValue;
+            if (l > 0) c.NearLakeTop = lakeTop;
+            if (lakeRing)
