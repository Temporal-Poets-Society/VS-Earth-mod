<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0649;CS0169;CS0414;CS8632;CS0219;CS0168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\earth-fable\src\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\earth-fable\src\EarthParams.cs" Link="EarthParams.cs" />
    <Compile Include="..\..\..\earth-fable\src\EarthMapConfig.cs" Link="EarthMapConfig.cs" />
    <Compile Include="..\..\..\earth-fable\tests\PlaytestReviewTests\ProtoStubs.cs" Link="ProtoStubs.cs" />
  </ItemGroup>
</Project>
