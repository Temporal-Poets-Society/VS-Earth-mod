<Project Sdk="Microsoft.NET.Sdk">
  <!-- PatchVanilla against the installed game's own assemblies: build the mod first (dotnet build EarthMap.csproj -c Release). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings><RollForward>LatestMajor</RollForward><UseAppHost>false</UseAppHost><NoWarn>CA1416</NoWarn>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NetCoreRuntimeDir>$([System.IO.Directory]::GetDirectories('$(NetCoreRoot)shared\Microsoft.NETCore.App', '10.*')[0])</NetCoreRuntimeDir>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(APPDATA)\Vintagestory</VintageStoryPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(NetCoreRuntimeDir)\System.*.dll" Exclude="$(NetCoreRuntimeDir)\System.Private.*.dll;$(NetCoreRuntimeDir)\System.IO.Compression.Native.dll" Private="false" />
    <Reference Include="$(NetCoreRuntimeDir)\System.Private.CoreLib.dll;$(NetCoreRuntimeDir)\netstandard.dll;$(NetCoreRuntimeDir)\mscorlib.dll" Private="false" />
    <Reference Include="EarthMap"><HintPath>../../bin/Release/mod/EarthMap.dll</HintPath></Reference>
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath></Reference>
    <Reference Include="VSEssentials"><HintPath>$(VintageStoryPath)/Mods/VSEssentials.dll</HintPath></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>$(VintageStoryPath)/Mods/VSSurvivalMod.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(VintageStoryPath)/Lib/0Harmony.dll</HintPath></Reference>
    <!-- the packed grass season map (ColorMapChecks.cs, EA-0154) -->
    <None Include="../../assets/earth/textures/environment/seasons/earthgrass-seasons.png" Link="earthgrass-seasons.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- where the game's other assemblies are found at run time -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>VintageStoryPath</_Parameter1><_Parameter2>$(VintageStoryPath)</_Parameter2></AssemblyAttribute>
  </ItemGroup>
</Project>
